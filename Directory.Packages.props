<!--
  Central package management: every package version lives here; .csproj files list packages without a
  version. Versions verified on nuget.org on 2026-10-06 (latest stable for .NET 10). Guide: §2.2.
  Pattern code (src/) may use only Microsoft packages; third-party libraries are named in the guide, never referenced.
-->
<Project>
  <!-- Used by Patterns.Creational (keyed services), Patterns.Structural (logging, configuration)
       and Patterns.Modern (DI, options, configuration, logging, object pool). Patterns.Behavioral gets
       them through its ASP.NET Core framework reference. -->
  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
  </ItemGroup>

  <!-- Used by every test project. Tests run on Microsoft.Testing.Platform (global.json, "test"), so neither
       Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio (the old VSTest pieces) are needed. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Used by Patterns.ArchitectureTests only. -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
  </ItemGroup>
</Project>
